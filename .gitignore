__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.env
.venv
env/
venv/
*.pyc

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

